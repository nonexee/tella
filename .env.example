# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/tella_ai?schema=public"
POSTGRES_PASSWORD="password"  # Change in production!

# Redis (for task queue)
REDIS_URL="redis://localhost:6379"

# OpenAI API (GPT-5)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-5"  # Update when GPT-5 is available

# Server
PORT=4000
NODE_ENV=development

# JWT Secret (MUST be at least 32 characters - server will reject shorter secrets)
JWT_SECRET="your-super-secret-jwt-key-at-least-32-characters-long"

# CORS Origins (comma-separated list of allowed origins)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Security Testing Configuration
MAX_CONCURRENT_AGENTS=5
AGENT_TIMEOUT_MS=300000
ENABLE_AGGRESSIVE_TESTING=false  # Set to true only in authorized environments

# Logging Configuration
LOG_LEVEL=info  # debug, info, warn, error
SLOW_QUERY_THRESHOLD=1000  # Log queries slower than this (ms)
LOG_ALL_QUERIES=false  # Set to true to log all database queries (debug only)
DISABLE_FILE_LOGGING=false  # Set to true for ephemeral containers (logs to stdout only)

# Frontend (Vite)
VITE_GRAPHQL_ENDPOINT="http://localhost:4000/graphql"
