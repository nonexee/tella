# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/tella_ai?schema=public"

# Redis (for task queue)
REDIS_URL="redis://localhost:6379"

# OpenAI API (GPT-5)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-5"  # Update when GPT-5 is available

# Server
PORT=4000
NODE_ENV=development

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Security Testing Configuration
MAX_CONCURRENT_AGENTS=5
AGENT_TIMEOUT_MS=300000
ENABLE_AGGRESSIVE_TESTING=false  # Set to true only in authorized environments
