# Docker Production Environment Configuration
# IMPORTANT: Copy this to .env and customize with your values
#
# Quick setup:
#   cp .env.docker .env
#   # Then edit .env with your secure values

# Database (used by docker-compose.yml)
# Use URL-safe characters only (hex recommended to avoid escaping issues)
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_THIS_32_CHAR_HEX_PASSWORD

# Required: Generate a secure JWT secret (min 64 chars recommended)
# Generate with: openssl rand -hex 32
# Or use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_64_CHARACTER_HEX_STRING_FOR_PRODUCTION_USE

# Optional: OpenAI API Key for AI features
# If not set, system will run but AI agents will be disabled
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Application Configuration
# Note: In production, frontend is served on port 4000 by the backend server
CORS_ORIGIN=http://localhost:4000
MAX_CONCURRENT_AGENTS=5
AGENT_TIMEOUT_MS=300000
ENABLE_AGGRESSIVE_TESTING=false

# Note: DATABASE_URL and REDIS_URL are auto-configured in docker-compose.yml
