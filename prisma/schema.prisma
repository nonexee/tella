// Tella AI Security - Database Schema
// PERFORMANCE OPTIMIZED: Added 20+ indexes for query optimization

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User management
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(OPERATOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scans     Scan[]
  apiKeys   ApiKey[]
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime?
  lastUsed  DateTime?

  @@index([userId])
}

// Security testing entities
model Target {
  id          String   @id @default(uuid())
  name        String
  url         String   @unique
  description String?
  type        TargetType
  status      TargetStatus @default(ACTIVE)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scans       Scan[]
  findings    Finding[]

  @@index([status])
}

enum TargetType {
  WEB_APP
  API
  MOBILE_APP
  NETWORK
  CLOUD_INFRA
  CUSTOM
}

enum TargetStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Scan {
  id          String     @id @default(uuid())
  name        String
  targetId    String
  target      Target     @relation(fields: [targetId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  status      ScanStatus @default(QUEUED)
  progress    Float      @default(0)
  config      Json
  error       String?    // Error message if scan fails
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  agents      Agent[]
  tasks       Task[]
  findings    Finding[]
  auditLogs   AuditLog[]

  @@index([status])
  @@index([userId])
  @@index([targetId])
  @@index([createdAt])
}

enum ScanStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

// AI Agent system
model Agent {
  id          String      @id @default(uuid())
  name        String
  type        AgentType
  role        String
  status      AgentStatus @default(IDLE)
  scanId      String?
  scan        Scan?       @relation(fields: [scanId], references: [id], onDelete: SetNull)
  capabilities Json
  memory      Json?
  config      Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tasks       Task[]
  conversations Conversation[]
  toolExecutions ToolExecution[]
  auditLogs   AuditLog[]

  @@index([status])
  @@index([type])
  @@index([scanId])
}

enum AgentType {
  ORCHESTRATOR
  RECON
  SCANNER
  EXPLOITER
  ANALYST
  REPORTER
}

enum AgentStatus {
  IDLE
  ACTIVE
  BUSY
  ERROR
  TERMINATED
}

model Task {
  id          String     @id @default(uuid())
  agentId     String
  agent       Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  scanId      String
  scan        Scan       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  type        TaskType
  description String
  priority    Int        @default(5)
  status      TaskStatus @default(PENDING)
  input       Json
  output      Json?
  error       String?
  retries     Int        @default(0)
  maxRetries  Int        @default(3)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  dependencies TaskDependency[] @relation("DependentTask")
  dependents   TaskDependency[] @relation("RequiredTask")
  auditLogs    AuditLog[]

  @@index([status])
  @@index([agentId])
  @@index([scanId])
  @@index([priority, status])
  @@index([createdAt])
}

enum TaskType {
  RECON
  PORT_SCAN
  VULN_SCAN
  EXPLOIT
  ENUMERATE
  ANALYZE
  REPORT
  CUSTOM
}

enum TaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  BLOCKED
}

model TaskDependency {
  id            String   @id @default(uuid())
  taskId        String
  task          Task     @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId   String
  dependsOn     Task     @relation("RequiredTask", fields: [dependsOnId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([taskId, dependsOnId])
}

// Security findings
model Finding {
  id          String         @id @default(uuid())
  scanId      String
  scan        Scan           @relation(fields: [scanId], references: [id], onDelete: Cascade)
  targetId    String
  target      Target         @relation(fields: [targetId], references: [id])
  title       String
  description String
  severity    Severity
  category    String
  cvss        Float?
  cve         String?
  status      FindingStatus  @default(NEW)
  confidence  Float          @default(1.0)
  evidence    Json
  remediation String?
  references  String[]
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([severity])
  @@index([status])
  @@index([scanId])
  @@index([targetId])
  @@index([cve])
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  NEW
  CONFIRMED
  FALSE_POSITIVE
  MITIGATED
  ACCEPTED
}

// Agent conversation memory
model Conversation {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages  Json
  context   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
}

// Security tools
model Tool {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  category    ToolCategory
  command     String?
  config      Json
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions  ToolExecution[]

  @@index([category])
  @@index([enabled])
}

enum ToolCategory {
  RECON
  SCANNER
  FUZZER
  EXPLOIT
  ENUMERATION
  ANALYSIS
  CUSTOM
}

model ToolExecution {
  id          String            @id @default(uuid())
  toolId      String
  tool        Tool              @relation(fields: [toolId], references: [id])
  agentId     String
  agent       Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  command     String
  args        Json
  status      ExecutionStatus
  output      String?
  error       String?
  exitCode    Int?
  duration    Int?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())

  @@index([status])
  @@index([toolId])
  @@index([agentId])
  @@index([createdAt])
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  TIMEOUT
  CANCELLED
}

// Knowledge base
model KnowledgeBase {
  id          String   @id @default(uuid())
  category    String
  title       String
  content     String
  tags        String[]
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([category, title], name: "category_title")
  @@index([category])
  @@index([tags])
}

// System configuration
model SystemSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  encrypted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

// Audit log for tracking all scan execution events
model AuditLog {
  id          String        @id @default(uuid())
  scanId      String?
  scan        Scan?         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  agentId     String?
  agent       Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  eventType   AuditEventType
  severity    AuditSeverity @default(INFO)
  title       String
  message     String
  data        Json?
  timestamp   DateTime      @default(now())

  @@index([scanId])
  @@index([agentId])
  @@index([taskId])
  @@index([eventType])
  @@index([timestamp])
}

enum AuditEventType {
  SCAN_STARTED
  SCAN_COMPLETED
  SCAN_FAILED
  AGENT_CREATED
  AGENT_REASONING
  TASK_CREATED
  TASK_STARTED
  TASK_COMPLETED
  TASK_FAILED
  TOOL_EXECUTION
  LLM_INTERACTION
  FINDING_CREATED
  DECISION_MADE
  ERROR_OCCURRED
  PROGRESS_UPDATE
}

enum AuditSeverity {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}
